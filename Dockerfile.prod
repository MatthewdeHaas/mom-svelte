# Bundle the Svelte app into vanilla JavaScript for production
FROM node:25-alpine AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci
COPY . .

RUN npm run build


# Run the app
FROM node:25-alpine

WORKDIR /app

COPY --from=builder /app/build build/
COPY --from=builder /app/package*.json ./

RUN npm ci --production

EXPOSE 3000

CMD ["node", "build"]
