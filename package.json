{
	"name": "admin-operations-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "TZ=UTC vitest",
		"test": "TZ=UTC dotenv -e .env.test -- pnpm run test:unit -- --run",
		"test:e2e": "TZ=UTC dotenv -e .env.test -- playwright test",
		"test:all": "pnpm run test && pnpm run test:e2e",
		"db:reset-test": "bash scripts/reset-test-db.sh",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"migrate": "tsx scripts/migrate.ts",
		"rust:sync-migrations": "bash scripts/sync-rust-migrations.sh",
		"rust:check": "pnpm run rust:sync-migrations && cargo check --manifest-path admin-operations-rust/Cargo.toml --workspace",
		"rust:test": "pnpm run rust:sync-migrations && cargo test --manifest-path admin-operations-rust/Cargo.toml --workspace",
		"seed:admin": "tsx scripts/seed-admin.ts",
		"seed:dev": "tsx --env-file=.env scripts/seed-dev.ts",
		"backfill": "tsx --env-file=.env scripts/backfill.ts"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.16.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24",
		"@types/pdfkit": "^0.17.6",
		"@types/pg": "^8.20.0",
		"@vitest/browser-playwright": "^4.1.3",
		"better-auth": "~1.4.21",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"dotenv-cli": "^11.0.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"pino-pretty": "^13.1.3",
		"playwright": "^1.60.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"chart.js": "^4.5.1",
		"exceljs": "^4.4.0",
		"jszip": "^3.10.1",
		"pdfkit": "^0.18.0",
		"pg": "^8.20.0",
		"pino": "^10.3.1",
		"resend": "^6.12.2",
		"svelte-sonner": "^1.1.1",
		"svg-to-pdfkit": "^0.1.8",
		"tsx": "^4.21.0",
		"zod": "^4.4.3"
	}
}
