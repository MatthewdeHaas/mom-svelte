POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Comma-separated list of email addresses allowed to sign in as admin
ADMIN_EMAILS=
# Initial password for the admin user(s) above. Set once, run `pnpm seed:admin`,
# then rotate from the admin UI. If unset, admins have no credential account
# and must receive a password via the admin UI from an already-logged-in admin.
ADMIN_INITIAL_PASSWORD=

# Email (Resend) — sender must be a verified domain in your Resend account
RESEND_API_KEY=
EMAIL_FROM=Meals on the Move <noreply@yourdomain.com>

# Log level for pino (trace | debug | info | warn | error | fatal).
# Defaults to 'debug' in dev, 'info' in production if unset.
LOG_LEVEL=

# Rust API (admin-operations-rust/). Both services must agree on
# INTERNAL_AUTH_SECRET — see docs/internal-auth.md. Generate with:
#   openssl rand -hex 32
RUST_API_URL=http://localhost:8080
INTERNAL_AUTH_SECRET=
