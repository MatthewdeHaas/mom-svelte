# Test database — separate from the dev DB so tests never touch real data.
# Used by: pnpm test (unit/integration) and pnpm test:e2e
#
# Run `pnpm db:reset-test` once to create this DB and apply migrations.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_DB=meals_test

# Better Auth — low-entropy secret is fine for local testing
BETTER_AUTH_SECRET=e2e-test-secret
BETTER_AUTH_URL=http://localhost:5174

# Required by auth.ts at startup (magic-link sender); unused in tests
EMAIL_FROM=Test <test@test.com>

# Resend key — not called during tests but must be present for the module to load
RESEND_API_KEY=re_placeholder

ADMIN_EMAIL=admin@test.com

# Password used by `pnpm seed:admin` and by E2E login specs. The value is
# fixed in test only — rotation is a prod-only concern.
ADMIN_INITIAL_PASSWORD=admin-test-password

# Rust service connection (used by downstream-identical.test.ts flag-ON path)
INTERNAL_AUTH_SECRET=test-internal-secret-32-bytes-minimum-aaaa
RUST_API_URL=http://127.0.0.1:8080
