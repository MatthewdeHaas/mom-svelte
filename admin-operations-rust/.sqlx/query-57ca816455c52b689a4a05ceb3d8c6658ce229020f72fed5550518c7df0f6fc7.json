  "query": "\n        UPDATE person\n        SET\n            name   = COALESCE($1, name),\n            active = COALESCE($2, active)\n        WHERE id = $3\n        RETURNING\n            id         AS \"id!: Uuid\",\n            company_id AS \"company_id!: Uuid\",\n            name       AS \"name!\",\n            active     AS \"active!\"\n        ",
