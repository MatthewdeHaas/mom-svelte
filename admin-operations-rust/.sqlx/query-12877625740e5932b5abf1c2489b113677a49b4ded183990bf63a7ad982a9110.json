  "query": "\n        SELECT\n            id               AS \"id!: Uuid\",\n            name             AS \"name!\",\n            contact_email,\n            phone,\n            shipping_address,\n            active           AS \"active!\",\n            created_at       AS \"created_at!: DateTime<Utc>\"\n        FROM company\n        WHERE LOWER(name) = LOWER($1)\n        ",
